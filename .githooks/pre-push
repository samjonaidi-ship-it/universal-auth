#!/usr/bin/env bash
# @samjonaidi-ship-it/universal-auth | .githooks/pre-push | v1.0.0 | 2026-05-08 | BB
# BUILD-1 (rc.5 audit): runs the same fast CI gates locally before any push,
# preventing rc.2/rc.3-class incidents (red lint landing on main because the
# commit was pushed before pnpm lint was checked).
#
# Install:
#   git config core.hooksPath .githooks
#
# Skip (emergency hotfix only):
#   git push --no-verify

set -euo pipefail

remote="$1"
url="$2"

# Only run when pushing to origin/main or any agent/* branch on origin.
# Other remotes (rebase mirrors, fork pushes) skip — this hook is a CI-parity
# guard, not a general code-quality gate.
if [[ "$remote" != "origin" ]]; then
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# A deletion pushes NO CONTENT, so there is nothing to typecheck. Git feeds one
# line per ref on stdin as "<local ref> <local sha> <remote ref> <remote sha>",
# and a deletion carries an all-zero LOCAL sha. This hook never read stdin, so
# `git push origin --delete <branch>` ran the full gate suite and failed —
# blocking routine branch cleanup on 2026-08-21 and steering the operator toward
# --no-verify, which the house rules forbid. Fail CLOSED: if stdin gives us no
# refs at all, run the gates rather than assuming a deletion.
ZERO="0000000000000000000000000000000000000000"
saw_ref=0
only_deletions=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ -z "${local_sha:-}" ]] && continue
  saw_ref=1
  [[ "$local_sha" != "$ZERO" ]] && only_deletions=0
done
if [[ "$saw_ref" == "1" && "$only_deletions" == "1" ]]; then
  echo "[pre-push] deletion-only push (no content) — skipping CI gates."
  exit 0
fi

echo "[pre-push] running CI build-job gates locally (skip with --no-verify)..."

# Mirror .github/workflows/ci.yml:30-40 exactly. Order matters — fail-fast on
# the cheapest gates first.
GATES=(
  "pnpm typecheck"
  "pnpm verify:readme"
  "pnpm verify:version-sync"
  "pnpm lint"
  "pnpm verify:no-jose"
  "pnpm verify:watermarks"
)

for gate in "${GATES[@]}"; do
  echo "[pre-push]   • $gate"
  if ! eval "$gate"; then
    echo ""
    echo "[pre-push] BLOCKED — '$gate' failed."
    echo "[pre-push] Fix locally + recommit, OR push with --no-verify if this is a documented hotfix."
    exit 1
  fi
done

echo "[pre-push] all CI build-job gates passed locally — push proceeding."
exit 0
